# Razorpay Test Mode Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# LLM API Key (choose one)
GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: 'gemini' or 'openai'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Database
DATABASE_URL=sqlite:///./agentguard.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Frontend API URL (for local dev)
VITE_API_URL=http://127.0.0.1:8000
# Backend admin API key. Use a long random value outside local tests.
ADMIN_API_KEY=dev-secret-change-me
# Frontend admin API key. Keep this equal to ADMIN_API_KEY for the demo UI.
VITE_ADMIN_API_KEY=dev-secret-change-me
